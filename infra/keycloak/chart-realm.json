      "firstName": "U1",
      "lastName": "Health Region",
      "groups": ["/india/madhya-pradesh"],
      "clientRoles": {
        "chart-api": ["health_planning_lead"]
      },
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ]
    },
    {
      "username": "u2-sector-region",
      "enabled": true,
      "email": "u2-sector-region@example.org",
      "firstName": "U2",
      "lastName": "Sector Region",
      "groups": ["/kenya/kajiado"],
      "clientRoles": {
