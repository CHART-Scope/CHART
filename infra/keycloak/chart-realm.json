        }
      ]
    },
    {
      "username": "u3-health-district",
      "enabled": true,
      "email": "u3-health-district@example.org",
      "firstName": "U3",
      "lastName": "Health District",
      "groups": ["/india/madhya-pradesh/bhopal"],
      "clientRoles": {
        "chart-api": ["health_implementation_officer"]
      },
      "credentials": [
        {
          "type": "password",
