{
  "realm": "chart",
  "enabled": true,
  "displayName": "CHART",
  "sslRequired": "none",
  "loginTheme": "chart",
  "roles": {
    "realm": [
      {
        "name": "offline_access"
      },
      {
        "name": "uma_authorization"
      }
    ],
    "client": {
      "chart-api": [
        {
          "name": "health_planning_lead",
          "description": "Health planning lead at state, county, or equivalent geography"
        },
        {
          "name": "cross_sector_planning_lead",
          "description": "Cross-sector planning lead at state, county, or equivalent geography"
        },
        {
          "name": "health_implementation_officer",
          "description": "Health implementation officer at district, sub-county, or equivalent geography"
        },
        {
          "name": "cross_sector_implementation_officer",
          "description": "Cross-sector implementation officer at district, sub-county, or equivalent geography"
        },
        {
          "name": "public_viewer",
          "description": "Public visitor or partner"
        },
        {
          "name": "chart_admin",
          "description": "CHART administrator"
        },
        {
          "name": "content_editor",
          "description": "Can manage CHART public content and solution repository records"
        }
      ]
    }
  },
  "groups": [
    {
      "name": "india",
      "attributes": {
        "country_code": ["IND"],
        "geo_level": ["country"]
      },
      "subGroups": [
        {
          "name": "madhya-pradesh",
          "attributes": {
            "country_code": ["IND"],
            "geo_level": ["geo_level_1"],
            "level_label": ["state"]
          },
          "subGroups": [
            {
              "name": "bhopal",
              "attributes": {
                "country_code": ["IND"],
                "geo_level": ["geo_level_2"],
                "level_label": ["division"]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "kenya",
      "attributes": {
        "country_code": ["KEN"],
        "geo_level": ["country"]
      },
      "subGroups": [
        {
          "name": "kajiado",
          "attributes": {
            "country_code": ["KEN"],
            "geo_level": ["geo_level_1"],
            "level_label": ["county"]
          },
          "subGroups": [
            {
              "name": "kajiado-central",
              "attributes": {
                "country_code": ["KEN"],
                "geo_level": ["geo_level_2"],
                "level_label": ["sub-county"]
              }
            }
          ]
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "chart-web",
      "name": "CHART web",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://localhost:3100/auth/callback",
        "http://127.0.0.1:3100/auth/callback"
      ],
      "webOrigins": ["http://localhost:3100", "http://127.0.0.1:3100"],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:3100##http://localhost:3100/*##http://127.0.0.1:3100##http://127.0.0.1:3100/*"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "chart-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "chart-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "chart-api",
      "name": "CHART API",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true
    }
  ],
  "users": [
    {
      "username": "chart-admin",
      "enabled": true,
      "email": "chart-admin@example.org",
      "firstName": "CHART",
      "lastName": "Admin",
      "groups": ["/india/madhya-pradesh", "/kenya/kajiado"],
      "clientRoles": {
        "chart-api": ["chart_admin", "content_editor"]
      },
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ]
    },
    {
      "username": "u1-health-region",
      "enabled": true,
