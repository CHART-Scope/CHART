{
  "name": "chart",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "web",
    "new_design"
  ],
  "scripts": {
    "dev:web": "npm --workspace @chart/web run dev",
    "build:web": "npm --workspace @chart/web run build",
    "start:web": "npm --workspace @chart/web run start",
    "typecheck:web": "npm --workspace @chart/web run typecheck",
    "storybook:web": "npm --workspace @chart/web run storybook",
    "build-storybook:web": "npm --workspace @chart/web run build-storybook",
    "dev:new-design": "npm --workspace @chart/new-design run dev",
    "build:new-design": "npm --workspace @chart/new-design run build",
    "typecheck:new-design": "npm --workspace @chart/new-design run typecheck",
    "storybook:new-design": "npm --workspace @chart/new-design run storybook",
    "build-storybook:new-design": "npm --workspace @chart/new-design run build-storybook",
    "identity:sync": "node infra/keycloak/sync-realm.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.5.3"
  },
  "overrides": {
    "vite": "6.4.1"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
