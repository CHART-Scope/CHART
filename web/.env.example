CHART_WEB_ORIGIN=http://127.0.0.1:3100
CHART_PYTHON_API_INTERNAL_URL=http://127.0.0.1:3210
CHART_LOCAL_PYTHON_API_URL=http://127.0.0.1:3210
# `make bootstrap-token` also stores CHART_BOOTSTRAP_TOKEN in web/.env.local
# for the Python API to read. The web server never sends it; paste it into the
# setup wizard's "Setup token" field.
NEXT_PUBLIC_KEYCLOAK_URL=http://127.0.0.1:8080
NEXT_PUBLIC_KEYCLOAK_REALM=chart
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=chart-web
