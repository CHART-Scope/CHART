# The backend does not automatically load this file. Export these values
# into the shell that runs `make climate-api` (or your process manager).

# CHART_BOOTSTRAP_TOKEN is required for first-run installation setup. For
# local dev, `make climate-api` and `make web` both depend on the
# `bootstrap-token` target, which generates the value on demand and writes
# it to web/.env.local; the same value is then injected into the backend
# process. For production, infra/aws/deploy-app.sh persists the token in
# the deployed .env. Only set it manually if you're running the backend
# outside `make climate-api`.
# CHART_BOOTSTRAP_TOKEN=

# Email is opt-in.
EMAIL_MODE=disabled
EMAIL_FROM_ADDRESS=no-reply@chart.local
EMAIL_FROM_NAME=CHART

# Local Mailpit defaults. Use 127.0.0.1 when the backend runs on the host,
# or chart-mailpit when the backend runs in the Docker Compose network.
EMAIL_SMTP_HOST=127.0.0.1
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_STARTTLS=false
EMAIL_SMTP_TIMEOUT_SECONDS=5
